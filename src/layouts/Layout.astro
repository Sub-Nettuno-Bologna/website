---
import "@/styles/global.css";
import Header from "@/components/layout/site/Header.astro";
import Footer from "@/components/layout/site/Footer.astro";
import Wave from "@/components/visuals/animations/Wave.astro";
import { Seo } from "astro-seo-meta";
import BaseSeoSchema from "@/seo/BaseSeoSchema.astro";
import WebsiteSeoSchema from "@/seo/WebsiteSeoSchema.astro";
import Analytics from '@vercel/analytics/astro'
const {
  noWaves = false,
  title = "Corsi Subacquea e Apnea Bologna | Club Sub Nettuno",
  description = "Scuola di subacquea e apnea a Bologna dal 1984. Corsi sub base, apnea e specialità con brevetti FIPSAS/CMAS riconosciuti in tutto il mondo. Prova sub e apnea gratuita, istruttori certificati, piscina a Bologna.",
  keywords = [
    "corsi sub Bologna",
    "corsi apnea Bologna",
    "scuola sub Bologna",
    "scuola apnea Bologna",
    "subacquea Bologna",
    "apnea Bologna",
    "brevetto sub Bologna",
    "prova gratuita sub Bologna",
    "prova gratuita apnea Bologna",
    "immersioni Bologna",
    "corsi CMAS FIPSAS Bologna",
  ],
} = Astro.props;

const siteName = "Club Sub Nettuno";
const themeColor = "#380099";
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="generator" content={Astro.generator} />

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="application-name" content={siteName} />
    <meta name="apple-mobile-web-app-title" content={siteName} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://cdn.sanity.io" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Science+Gothic:wght@100..900&display=swap"
      rel="stylesheet"
    />

     <!-- Other stuff -->

    <Seo
      title={title}
      description={description}
      keywords={keywords}
      icon="/favicon.ico"
      themeColor={themeColor}
      colorScheme="light"
      robots="index, follow"
      facebook={{
        image: "/logo.svg",
        url: "https://subnettuno.it",
        type: "website",
      }}
      twitter={{
        image: "/logo.svg",
        site: "@clubsubnettuno",
        card: "summary",
      }}
    />

    <BaseSeoSchema />
    <WebsiteSeoSchema />
    <style>
      .below-the-fold {
        content-visibility: auto;
        contain-intrinsic-size: 1px 800px;
      }
    </style>
  </head>
  <body>
    <Analytics />

    <a
      href="#content"
      class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 focus:bg-white focus:text-black focus:px-3 focus:py-2 focus:rounded-md"
      >Salta al contenuto principale</a
    >
    <Header />

    <main id="content">
      <slot />
      {
        !noWaves && (
          <div class="relative px-8 py-12 bg-gray-50 below-the-fold">
            <Wave />
          </div>
        )
      }
    </main>
    <div class="below-the-fold">
      <Footer />
    </div>
  </body>
</html>
