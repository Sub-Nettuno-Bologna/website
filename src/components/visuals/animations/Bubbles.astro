  }
  .bubble:nth-child(16) {
    left: 75%;
    animation-delay: 12.8s;
  }
  .bubble:nth-child(17) {
    left: 85%;
    animation-delay: 14.6s;
  }
  .bubble:nth-child(18) {
    left: 95%;
    animation-delay: 16.4s;
  }
  .bubble:nth-child(19) {
    left: 5%;
    animation-delay: 1s;
  }
  .bubble:nth-child(20) {
    left: 85%;
    animation-delay: 13.2s;
  }
</style>
