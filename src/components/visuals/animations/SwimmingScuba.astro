---
const { maxDepth = "40m" } = Astro.props;

const parsedDepth = Number.parseInt(String(maxDepth).replace(/[^0-9]/g, ""), 10);
const depthValue = Number.isFinite(parsedDepth) ? Math.min(40, Math.max(0, parsedDepth)) : 0;

const meterStops = [0, 18, 30, 40];
const meterOffsetTopPx = 0;
const meterExtraOffsetPx = 0;
const meterScalePx = 12 + (depthValue / 40) * 4; // 12–16px per metro
const meterPosition = (value: number) =>
  `${meterOffsetTopPx + value * meterScalePx + meterExtraOffsetPx}px`;

const diveDistancePx = Math.max(0, depthValue * meterScalePx - 50);
const bounceOffsetPx = Math.round(meterScalePx * 2);
---

<style>
  .scuba-container {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
    z-index: 5;
  }

  .depth-meter {
    position: absolute;
    right: 12px;
    left: auto;
    top: 12%;
    bottom: 8%;
    width: 52px;
    color: rgba(255, 255, 255, 0.7);
    font-size: 12px;
    font-weight: 600;
    text-align: right;
  }

  .depth-line {
    position: absolute;
    right: 18px;
    left: auto;
    top: 0;
    bottom: 0;
    width: 2px;
    border-radius: 999px;
    background: linear-gradient(
      180deg,
      rgba(255, 255, 255, 0.15),
      rgba(255, 255, 255, 0.4),
      rgba(255, 255, 255, 0.15)
    );
  }

  .meter-tick {
    position: absolute;
    right: 0;
    left: auto;
    display: inline-flex;
    align-items: center;
    justify-content: flex-end;
    flex-direction: row-reverse;
    gap: 8px;
    padding: 2px 6px;
    border-radius: 999px;
    background: rgba(0, 0, 0, 0.25);
    backdrop-filter: blur(8px);
  }

  .tick-mark {
    display: inline-block;
    width: 12px;
    height: 2px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.7);
  }

  .scuba-diver {
    position: absolute;
    top: 0;
    right: 6%;
    animation: dive 12s ease-in-out infinite;
  }

  #scuba1-container {
    animation-delay: 0s;
    transform: scale(0.8);
  }

  .scuba-svg {
    width: 220px;
    height: auto;
    filter: drop-shadow(0 12px 24px rgba(0, 0, 0, 0.2));
  }

  @keyframes dive {
    0% {
      transform: translate(50%, 0) scale(0.8);
    }
    35% {
      transform: translate(24%, var(--dive-distance)) scale(0.8);
    }
    65% {
      transform: translate(18%, calc(var(--dive-distance) + var(--dive-bounce))) scale(0.8);
    }
    100% {
      transform: translate(50%, 0) scale(0.8);
    }
  }

  @media (max-width: 768px) {
    .depth-meter {
      right: 8px;
      left: auto;
      top: 14%;
      width: 48px;
      font-size: 11px;
      text-align: right;
    }

    .meter-tick {
      padding: 2px 5px;
    }

    #scuba1-container {
      right: 0;
      transform: scale(0.6);
    }

    .scuba-svg {
      width: 160px;
    }

    @keyframes dive {
      0% {
        transform: translate(40%, 0) scale(0.6);
      }
      40% {
        transform: translate(12%, var(--dive-distance)) scale(0.6);
      }
      100% {
        transform: translate(40%, 0) scale(0.6);
      }
    }
  }
</style>

<div
  class="scuba-container"
  style={`--dive-distance: ${diveDistancePx}px; --dive-bounce: ${bounceOffsetPx}px;`}
>
  <div class="depth-meter" aria-hidden="true">
    <div class="depth-line"></div>
    {
      meterStops.map((value) => (
        <div class="meter-tick" style={`top: ${meterPosition(value)};`}>
          <span class="tick-mark" />
          <span>{value}m</span>
        </div>
      ))
    }
  </div>
  <div id="scuba1-container" class="scuba-diver">
    <svg
      xmlns="http://www.w3.org/2000/svg"
      class="scuba-svg"
      viewBox="0 0 140 70"
      role="img"
      aria-hidden="true"
    >
