---
import { pagesData } from "@/data/pages";

export interface Props {
  message?: string;
  onRetryHref?: string;
}

const { message, onRetryHref } = Astro.props;
---

<div class="text-center py-12">
  <div class="text-red-400 mb-4">
    <svg class="w-16 h-16 mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="1"
        d="M12 9v4m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"
      ></path>
    </svg>
  </div>
  <h3 class="text-lg font-medium text-gray-900 mb-2">{pagesData.states.error.title}</h3>
  <p class="text-gray-500 max-w-xl mx-auto">{message || pagesData.states.error.description}</p>
  {
    onRetryHref && (
      <div class="mt-6">
        <a
          href={onRetryHref}
          class="inline-flex items-center px-4 py-2 rounded-md border border-red-500 text-red-600 hover:bg-red-500 hover:text-white transition-colors"
        >
          {pagesData.states.error.retry}
        </a>
      </div>
    )
  }
</div>
