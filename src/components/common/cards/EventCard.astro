---
import { Calendar, MapPin, Users } from "@lucide/astro";
import type { Event } from "../../../../sanity.types";
import FeatureCard from "./FeatureCard.astro";
import { pagesData } from "@/data/pages";
import { buildImageUrl } from "@/lib/sanity";
import { formatDate, isPast, isRegistrationClosed } from "@/lib/utils";

export interface Props {
  event: Event;
}

const { event } = Astro.props;

// Determine event status
const isConcluded = event.eventDate ? isPast(event.eventDate) : false;
const isRegClosed = isRegistrationClosed({
  registrationRequired: event.registrationRequired,
  registrationDeadline: event.registrationDeadline,
});

const badges = [
  {
    text: isConcluded ? pagesData.eventi.labels.concluded : pagesData.eventi.labels.active,
    color: isConcluded ? "tertiary" : "accent",
  },
  ...(isRegClosed
    ? [
        {
          text: pagesData.eventi.labels.registrationClosed,
          color: "secondary",
        },
      ]
    : []),
] satisfies Array<{ text: string; color: "primary" | "accent" | "secondary" | "tertiary" }>;
---

<FeatureCard
  blurred
  title={event.title || ""}
  image={buildImageUrl(event.featuredImage, { width: 500, height: 650 })}
  badge={badges}
  details={[
    ...(event.eventDate
      ? [
          {
            icon: Calendar,
            text: formatDate(event.eventDate || ""),
          },
        ]
      : []),
    ...(event.location
      ? [
          {
            icon: MapPin,
            text: event.location || "",
          },
        ]
      : []),
    ...(event.maxParticipants
      ? [
          {
            icon: Users,
            text: `${pagesData.eventi.participantsLabel} ${event.maxParticipants}`,
          },
        ]
      : []),
  ]}
  action={{
    text: pagesData.commons.learnMore,
    href: `/eventi/${event.slug?.current}`,
    color: "secondary",
  }}
/>
