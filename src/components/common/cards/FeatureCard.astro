---
import { PortableText } from "astro-portabletext";
import Badge from "@/components/primitives/Badge.astro";
import Button from "@/components/primitives/Button.astro";

export interface Props {
  title: string;
  description?: any;
  image: string;
  blurred?: boolean;
  details: {
    icon: any;
    text: string;
  }[];
  action?: {
    text: string;
    href: string;
    color?: "primary" | "secondary";
  };
  badge?:
    | {
    text: string;
    color?: "primary" | "accent" | "secondary" | "tertiary";
    }
    | Array<{
        text: string;
        color?: "primary" | "accent" | "secondary" | "tertiary";
      }>;
}

const { title, description, image, details, action, blurred = true, badge } = Astro.props;

const badges = Array.isArray(badge) ? badge : badge ? [badge] : [];
const getBadgeVariant = (color?: "primary" | "accent" | "secondary" | "tertiary") =>
  color === "secondary" ? "secondary" : color === "tertiary" ? "outline" : color === "accent" ? "accent" : "default";
---

<article
  class="group bg-white rounded-xl border border-gray-100 shadow-sm hover:shadow-md md:hover:shadow-xl transition-all md:hover:-translate-y-1 flex flex-col h-full max-w-md overflow-hidden"
>
  {
    image && (
      <div class="relative overflow-hidden">
        {blurred ? (
          <>
            <img
              src={image}
              alt=""
              aria-hidden="true"
              width={300}
              height={200}
              class="block absolute inset-0 w-full h-48 object-cover blur-md"
            />
            <img
              src={image}
              alt={title}
              width={300}
              height={200}
              class="block relative w-full h-48 object-contain z-10"
            />
          </>
        ) : (
          <img
            src={image}
            alt={title}
            width={300}
            height={200}
            class="block w-full h-48 object-contain"
          />
        )}
      </div>
    )
  }

  <div class="p-5 md:p-6 flex flex-col flex-1">
    <div class="flex-1">
      <div>
        {
          badges.length > 0 && (
            <div class="mb-3 flex flex-wrap gap-2">
              {badges.map((b) => (
                <Badge variant={getBadgeVariant(b.color)}>{b.text}</Badge>
              ))}
            </div>
          )
        }
        <h3 class="text-lg md:text-xl font-semibold tracking-tight leading-snug text-tertiary">
          {title}
        </h3>
        <div class="mt-2 text-sm leading-relaxed text-gray-600">
          {typeof description === "string" ? description : <PortableText value={description} />}
        </div>
        <div class="mt-3 md:mt-4 md:mb-4 space-y-2 text-sm text-gray-500">
          {
            details.map((detail) => (
              <div class="flex items-center gap-2">
                <detail.icon class="w-4 h-4 md:w-5 md:h-5 text-primary" aria-hidden="true" />
                <span>{detail.text}</span>
              </div>
            ))
          }
        </div>
      </div>
    </div>
    {
      action && (
        <div class="mt-5">
          <Button href={action.href} class="w-full text-sm md:text-base" variant="default">
            {action.text}
          </Button>
        </div>
      )
    }
  </div>
</article>
