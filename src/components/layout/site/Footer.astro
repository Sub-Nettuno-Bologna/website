---
import { footerData } from "@/data/footer";
import { pagesData } from "@/data/pages";
import SectionContainer from "@/components/layout/Section.astro";
import { getClubData } from "@/services/club";
import { headerData } from "@/data/header";
import { formatOpeningHoursCompact } from "@/lib/formatters";

const clubData = await getClubData();

// Build contact lines dynamically from club data
const openingHoursLine = clubData?.openingHours
  ? formatOpeningHoursCompact(clubData.openingHours)
  : clubData?.phoneSchedule || "";

const contactLines = clubData
  ? [
      clubData.clubName,
      clubData.address,
      clubData.phone ? `Tel. ${clubData.phone}` : "",
      openingHoursLine,
      clubData.cf ? `C.F. ${clubData.cf}` : "",
      clubData.piva ? `P.IVA ${clubData.piva}` : "",
      clubData.email,
    ].filter(Boolean)
  : [];

// Build footer sections from header navigation
const makeLink = (item: any) => ({ text: item.label, href: item.href });

const footerSections = [
  {
    title: "Corsi",
    links:
      headerData.navigation.find((item: any) => item.label === "Corsi")?.dropdown?.map(makeLink) ||
      [],
  },
  {
    title: "Club",
    links: headerData.navigation.filter((item: any) => item.label !== "Corsi").map(makeLink),
  },
];
---

<footer class="bg-secondary text-white" role="contentinfo">
  <SectionContainer background="default" padding="md" customClass="!bg-transparent">
    <div class="grid md:grid-cols-4 gap-8">
      <div>
        <div class="mb-4">
          <h3 class="font-bold">{clubData?.clubName || ""}</h3>
          <p class="text-sm text-gray-300">{clubData?.subtitle || ""}</p>
        </div>
        <p class="text-gray-300 text-sm">
          {clubData?.description || ""}
        </p>
      </div>
      {
        footerSections.map((section) => (
          <div>
            <h4 class="font-semibold mb-4">{section.title}</h4>
            <ul class="space-y-2 text-sm text-gray-300">
              {section.links.map((link) => (
                <li>
                  <a href={link.href} class="hover:text-white">
                    {link.text}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
      <div>
        <h4 class="font-semibold mb-4">{pagesData.contact.contactLabels.title}</h4>
        <ul class="space-y-2 text-sm text-gray-300">
          {contactLines.map((line) => <li>{line}</li>)}
        </ul>
      </div>
    </div>
    <div class="border-t border-gray-600 mt-8 pt-8 text-center text-sm text-gray-300">
      <p>
        &copy; {new Date().getFullYear()}{" "}
        {clubData?.clubName || ""} Bologna. Tutti i diritti riservati.
      </p>
      <p class="mt-2">{footerData.copyright.affiliation}</p>
    </div>
  </SectionContainer>
</footer>
