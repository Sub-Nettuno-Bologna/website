---
import * as LucideIcons from "@lucide/astro";
import type { Aboutus } from "sanity.types";
import SectionContainer from "@/components/layout/Section.astro";
import SectionHeader from "@/components/layout/SectionHeader.astro";
import StandardCard from "@/components/common/cards/StandardCard.astro";
import { buildImageUrl } from "@/lib/sanity";
import { toPascalCase } from "@/lib/utils";

export interface Props extends Partial<Aboutus> {}

const { title, subtitle, image, imageCaption, features } = Astro.props;
---

<SectionContainer
  id="chi-siamo"
  background="gradient-secondary"
  padding="sm"
  customClass="pt-4 pb-10"
  waveBottom
>
  <SectionHeader
    title={title}
    subtitle={subtitle}
    titleColor="primary-content"
    subtitleColor="secondary"
  />

  <div class="grid md:grid-cols-5 gap-8 items-center">
    <div class="md:col-span-2 flex flex-col items-center">
      <div class="space-y-4">
        <img
          src={buildImageUrl(image, { width: 600, height: 350 })}
          width={600}
          height={400}
          alt="Immagine del club"
          class="rounded-lg shadow-lg w-full h-auto"
          loading="lazy"
          decoding="async"
        />
        <div class="flex flex-col items-center text-center space-y-2">
          <LucideIcons.ArrowDown class="w-6 h-6 text-primary animate-bounce" />
          <p class="text-sm text-secondary italic sketch-text">
            {imageCaption}
          </p>
        </div>
      </div>
    </div>

    <div class="space-y-2 md:col-span-3">
      {
        features?.map((feature: any) => {
          const iconName = toPascalCase(feature.icon) as keyof typeof LucideIcons;
          const Icon = (LucideIcons as any)[iconName] ?? null;
          return (
            <StandardCard
              variant="default"
              hoverEffect={false}
              customClass="u-card hover:bg-white/5 p-4"
            >
              <div class="flex items-start space-x-4">
                <div class="w-12 h-12 bg-secondary rounded-full flex items-center justify-center flex-shrink-0 transform transition-transform duration-300 hover:scale-110">
                  {Icon && <Icon class="w-6 h-6 text-white" />}
                </div>
                <div>
                  <h3 class="text-xl font-semibold text-primary-content mb-2">{feature.title}</h3>
                  <p class="text-secondary leading-relaxed">{feature.description}</p>
                </div>
              </div>
            </StandardCard>
          );
        })
      }
    </div>
  </div>
</SectionContainer>

<style>
  .sketch-text {
    font-family: "Comic Sans MS", sans-serif;
  }
</style>
