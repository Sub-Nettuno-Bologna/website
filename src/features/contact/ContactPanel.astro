---
import Card from "@/components/primitives/Card/Card.astro";
import CardContent from "@/components/primitives/Card/CardContent.astro";
import CardHeader from "@/components/primitives/Card/CardHeader.astro";
import ContactFormSection from "@/features/contact/ContactForm.astro";
import { pagesData, type ContactForm } from "@/data/pages";
import * as LucideIcons from "@lucide/astro";
import { formatOpeningHoursDetailed } from "@/lib/formatters";

export interface Props {
  phoneNumber?: string;
  phoneSchedule?: string;
  email?: string;
  whatsAppNumbers?: string[];
  openingHours?: Array<{
    dayOfWeek?: string[];
    opens?: string;
    closes?: string;
  }>;
  address?: {
    text: string;
    lines?: string[];
    mapUrl?: string;
    embedMapUrl?: string;
  };
  socialMedia?: Array<{
    platform: string;
    url: string;
    ariaLabel: string;
  }>;
  form: ContactForm;
  containerClass?: string;
  formHiddenFields?: Record<string, string>;
  formDefaultMessage?: string;
}

const {
  phoneNumber,
  phoneSchedule,
  email,
  whatsAppNumbers = [],
  openingHours,
  address,
  socialMedia = [],
  form,
  containerClass = "w-full my-8",
  formHiddenFields = {},
  formDefaultMessage,
} = Astro.props;

const detailedHours = formatOpeningHoursDetailed(openingHours);
---

<Card class={`${containerClass} content-card content-card-5 mx-auto max-w-5xl`}>
  <CardHeader />
  <CardContent>
    <div class="space-y-10">
      <!-- Contact Info -->
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-3 gap-8">
        <!-- Phone -->
        {
          phoneNumber && (
            <div class="h-full">
              <div class="flex items-start gap-4 py-4">
                <div class="w-10 h-10 bg-primary rounded-full flex items-center justify-center flex-shrink-0">
                  <LucideIcons.Phone class="w-5 h-5 text-white" />
                </div>
                <div>
                  <h3 class="text-sm font-semibold leading-6">
                    {pagesData.contact.contactLabels.phone}
                  </h3>
                  <p class="mt-1 text-lg font-medium">
                    <a
                      href={`tel:${phoneNumber.replace(/\s/g, "")}`}
                      class="hover:text-primary transition-colors"
                    >
                      {phoneNumber}
                    </a>
                  </p>
                  {phoneSchedule && (
                    <span class="mt-1 inline-flex items-center gap-2 text-xs leading-5 text-muted-foreground">
                      <LucideIcons.Clock class="w-3.5 h-3.5" />
                      {phoneSchedule}
                    </span>
                  )}
                </div>
              </div>
            </div>
          )
        }
        <!-- WhatsApp -->
        {
          whatsAppNumbers.length > 0 && (
            <div class="h-full">
              <div class="flex items-start gap-4 py-4">
                <div class="w-10 h-10 bg-primary rounded-full flex items-center justify-center flex-shrink-0">
                  <LucideIcons.MessageCircle class="w-5 h-5 text-white" />
                </div>
                <div>
                  <h3 class="text-sm font-semibold leading-6">
                    {pagesData.contact.contactLabels.whatsapp}
                  </h3>
                  <div class="mt-1 space-y-1">
                    {whatsAppNumbers.map((whatsAppNumber) => (
                      <p class="text-lg font-medium">
                        <a
                          href={`https://wa.me/${whatsAppNumber.replace(/\s/g, "")}`}
                          class="hover:text-primary transition-colors"
                          target="_blank"
                          rel="noopener noreferrer"
                        >
                          {whatsAppNumber}
                        </a>
                      </p>
                    ))}
                  </div>
                </div>
              </div>
            </div>
          )
        }

        <!-- Email -->
        {
          email && (
            <div class="h-full">
              <div class="flex items-start gap-4 py-4">
                <div class="w-10 h-10 bg-primary rounded-full flex items-center justify-center flex-shrink-0">
                  <LucideIcons.Mail class="w-5 h-5 text-white" />
                </div>
                <div>
                  <h3 class="text-sm font-semibold leading-6">
                    {pagesData.contact.contactLabels.email}
                  </h3>
                  <p class="mt-1 text-lg font-medium">
                    <a href={`mailto:${email}`} class="hover:text-primary transition-colors">
                      {email}
                    </a>
                  </p>
                </div>
              </div>
            </div>
          )
        }
      </div>

      <!-- Contact Form -->
      <ContactFormSection
        formTitle={form.title}
        formDescription={form.description}
        formFieldsPlaceholder={form.fieldsPlaceholder}
        formDefaultMessage={formDefaultMessage ?? form.defaultMessage}
        submitButtonText={form.submitButton}
        formHiddenFields={formHiddenFields}
      />

      <!-- Address and Social below the form -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        {
          address && (
            <div class="h-full">
              <div class="flex items-start gap-4 py-4">
                <div class="w-10 h-10 bg-primary rounded-full flex items-center justify-center flex-shrink-0">
                  <LucideIcons.MapPin class="w-5 h-5 text-white" />
                </div>
                <div>
                  <h3 class="text-sm font-semibold leading-6">
                    {pagesData.contact.contactLabels.address}
                  </h3>
                  <p class="mt-1 text-base leading-6 text-muted-foreground">
                    <a
                      href={address.mapUrl}
                      class="hover:text-primary transition-colors"
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      <span class="space-y-0.5">
                        {(address.lines ?? [address.text]).map((line: string) => (
                          <span class="block">{line}</span>
                        ))}
                      </span>
                    </a>
                    {phoneSchedule && (
                      <span class="mt-1 inline-flex items-center gap-2 text-xs leading-5 text-muted-foreground">
                        <LucideIcons.Clock class="w-3.5 h-3.5" />
                        {phoneSchedule}
                      </span>
                    )}
                  </p>
                  {address.embedMapUrl && (
                    <div class="mt-4 aspect-video w-full">
                      <iframe
                        src={address.embedMapUrl}
                        width="100%"
                        height="100%"
                        class="rounded-lg border-0"
                        loading="lazy"
                        referrerpolicy="no-referrer-when-downgrade"
                        title={pagesData.ui.maps.clubLocationTitle}
                      />
                    </div>
                  )}
                </div>
              </div>
            </div>
          )
        }

        {
          socialMedia.length > 0 && (
            <div class="h-full">
              <div class="flex flex-col gap-3 py-4">
                <h3 class="text-sm font-semibold leading-6">
                  {pagesData.contact.socialMediaLabels.title}
                </h3>
                <p class="text-sm leading-6 text-muted-foreground max-w-prose">
                  {pagesData.contact.socialMediaLabels.description}
                </p>
                <div class="flex flex-wrap items-center gap-3">
                  {socialMedia.map((social) => {
                    const Icon = (LucideIcons as any)[social.platform] ?? null;
                    return (
                      <a
                        href={social.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center justify-center w-10 h-10 rounded-full bg-primary hover:bg-primary/90 transition-colors duration-200"
                        aria-label={social.ariaLabel}
                      >
                        {Icon && <Icon class="w-5 h-5 text-white" />}
                      </a>
                    );
                  })}
                </div>
              </div>
            </div>
          )
        }
      </div>
    </div>
  </CardContent>
</Card>
