---
import Card from "@/components/primitives/Card/Card.astro";
import CardContent from "@/components/primitives/Card/CardContent.astro";
import CardHeader from "@/components/primitives/Card/CardHeader.astro";
import ContactFormSection from "@/features/contact/ContactForm.astro";
import { pagesData, type ContactForm } from "@/data/pages";
import * as LucideIcons from "@lucide/astro";
import { formatOpeningHoursCompact } from "@/lib/formatters";
import { buildWhatsAppUrl } from "@/lib/contact";

export interface Props {
  phoneNumber?: string;
  phoneSchedule?: string;
  email?: string;
  whatsAppNumbers?: string[];
  openingHours?: Array<{
    dayOfWeek?: string[];
    opens?: string;
    closes?: string;
  }>;
  address?: {
    text: string;
    lines?: string[];
    mapUrl?: string;
    embedMapUrl?: string;
  };
  socialMedia?: Array<{
    platform: string;
    url: string;
    ariaLabel: string;
  }>;
  form: ContactForm;
  containerClass?: string;
  formHiddenFields?: Record<string, string>;
  formDefaultMessage?: string;
}

const {
  phoneNumber,
  phoneSchedule,
  email,
  whatsAppNumbers = [],
  openingHours,
  address,
  socialMedia = [],
  form,
  containerClass = "w-full my-8",
  formHiddenFields = {},
  formDefaultMessage,
} = Astro.props;

const openingHoursLine = formatOpeningHoursCompact(openingHours) || phoneSchedule;
const whatsAppMessage = formDefaultMessage ?? form.defaultMessage;
---

<Card class={`${containerClass} content-card content-card-5 mx-auto max-w-5xl`}>
  <CardHeader />
  <CardContent>
    <div class="space-y-10">
      <!-- Contact Info -->
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-3 gap-8">
        <!-- Phone -->
        {
          phoneNumber && (
            <div class="h-full">
              <div class="flex items-start gap-4 py-4">
                <div class="w-10 h-10 bg-primary rounded-full flex items-center justify-center flex-shrink-0">
                  <LucideIcons.Phone class="w-5 h-5 text-white" />
                </div>
                <div>
                  <h3 class="text-sm font-semibold leading-6">
                    {pagesData.contact.contactLabels.phone}
                  </h3>
                  <p class="mt-1 text-lg font-medium">
                    <a
                      href={`tel:${phoneNumber.replace(/\s/g, "")}`}
                      class="hover:text-primary transition-colors"
                    >
                      {phoneNumber}
                    </a>
                  </p>
                  {phoneSchedule && (
                    <span class="mt-1 inline-flex items-center gap-2 text-xs leading-5 text-muted-foreground">
                      <LucideIcons.Clock class="w-3.5 h-3.5" />
                      {phoneSchedule}
                    </span>
                  )}
                </div>
              </div>
            </div>
          )
        }
        <!-- WhatsApp -->
        {
          whatsAppNumbers.length > 0 && (
            <div class="h-full">
              <div class="flex items-start gap-4 py-4">
                <div class="w-10 h-10 bg-primary rounded-full flex items-center justify-center flex-shrink-0">
                  <LucideIcons.MessageCircle class="w-5 h-5 text-white" />
                </div>
                <div>
                  <h3 class="text-sm font-semibold leading-6">
                    {pagesData.contact.contactLabels.whatsapp}
                  </h3>
                  <div class="mt-1 space-y-1">
                    {whatsAppNumbers.map((whatsAppNumber) => (
                      <p class="text-lg font-medium">
                        <a
                          href={buildWhatsAppUrl(whatsAppNumber, whatsAppMessage)}
                          class="hover:text-primary transition-colors"
                          target="_blank"
                          rel="noopener noreferrer"
                        >
                          {whatsAppNumber}
                        </a>
                      </p>
                    ))}
                  </div>
                </div>
              </div>
            </div>
          )
        }

        <!-- Email -->
        {
          email && (
            <div class="h-full">
              <div class="flex items-start gap-4 py-4">
                <div class="w-10 h-10 bg-primary rounded-full flex items-center justify-center flex-shrink-0">
                  <LucideIcons.Mail class="w-5 h-5 text-white" />
                </div>
                <div>
                  <h3 class="text-sm font-semibold leading-6">
                    {pagesData.contact.contactLabels.email}
                  </h3>
                  <p class="mt-1 text-lg font-medium">
                    <a href={`mailto:${email}`} class="hover:text-primary transition-colors">
                      {email}
                    </a>
                  </p>
                </div>
              </div>
            </div>
          )
        }
      </div>

      <!-- Contact Form -->
      <ContactFormSection
        formTitle={form.title}
        formDescription={form.description}
        formFieldsPlaceholder={form.fieldsPlaceholder}
        formDefaultMessage={formDefaultMessage ?? form.defaultMessage}
        submitButtonText={form.submitButton}
        formHiddenFields={formHiddenFields}
      />

      <!-- Address and Social below the form -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        {
          address && (
            <div class="h-full">
              <div class="flex items-start gap-4 py-4">
                <div class="w-10 h-10 bg-primary rounded-full flex items-center justify-center flex-shrink-0">
                  <LucideIcons.MapPin class="w-5 h-5 text-white" />
                </div>
                <div>
                  <h3 class="text-sm font-semibold leading-6">
                    {pagesData.contact.contactLabels.address}
                  </h3>
                  <p class="mt-1 text-base leading-6 text-muted-foreground">
                    <a
                      href={address.mapUrl}
                      class="hover:text-primary transition-colors"
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      <span class="space-y-0.5">
                        {(address.lines ?? [address.text]).map((line: string) => (
                          <span class="block">{line}</span>
                        ))}
                      </span>
                    </a>
                    {openingHoursLine && (
                      <span class="mt-1 inline-flex items-center gap-2 text-xs leading-5 text-muted-foreground">
                        <LucideIcons.Clock class="w-3.5 h-3.5" />
                        {openingHoursLine}
                      </span>
                    )}
                  </p>
                  {address.embedMapUrl && (
                    <div class="mt-4 aspect-video w-full">
                      <iframe
                        src={address.embedMapUrl}
                        width="100%"
                        height="100%"
                        class="rounded-lg border-0"
                        loading="lazy"
                        referrerpolicy="no-referrer-when-downgrade"
                        title={pagesData.ui.maps.clubLocationTitle}
                      />
                    </div>
                  )}
                </div>
              </div>
            </div>
          )
        }

        {
          socialMedia.length > 0 && (
            <div class="h-full">
              <div class="flex flex-col gap-3 py-4">
                <h3 class="text-sm font-semibold leading-6">
                  {pagesData.contact.socialMediaLabels.title}
                </h3>
                <p class="text-sm leading-6 text-muted-foreground max-w-prose">
                  {pagesData.contact.socialMediaLabels.description}
                </p>
                <div class="flex flex-wrap items-center gap-3">
                  {socialMedia.map((social) => {
                    const LucideIcon =
                      social.platform !== "Facebook" &&
                      social.platform !== "Instagram"
                        ? ((LucideIcons as any)[social.platform] ?? null)
                        : null;
                    return (
                      <a
                        href={social.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center justify-center w-10 h-10 rounded-full bg-primary hover:bg-primary/90 transition-colors duration-200"
                        aria-label={social.ariaLabel}
                      >
                        {social.platform === "Facebook" && (
                          <svg
                            class="w-5 h-5 text-white"
                            viewBox="0 0 24 24"
                            fill="currentColor"
                            aria-hidden="true"
                          >
                            <path
                              d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"
                            />
                          </svg>
                        )}
                        {social.platform === "Instagram" && (
                          <svg
                            class="w-5 h-5 text-white"
                            viewBox="0 0 24 24"
                            fill="currentColor"
                            aria-hidden="true"
                          >
                            <path
                              d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"
                            />
                          </svg>
                        )}
                        {LucideIcon && <LucideIcon class="w-5 h-5 text-white" />}
                      </a>
                    );
                  })}
                </div>
              </div>
            </div>
          )
        }
      </div>
    </div>
  </CardContent>
</Card>
