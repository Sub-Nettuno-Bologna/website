---
import type { Blog as BlogPost } from "../../../sanity.types";
import BlogCard from "@/components/common/cards/BlogCard.astro";
import SectionContainer from "@/components/layout/Section.astro";
import SectionHeader from "@/components/layout/SectionHeader.astro";
import EmptyState from "@/components/states/EmptyState.astro";
import { pagesData } from "@/data/pages";

export interface Props {
  posts: BlogPost[];
  title: string;
  subtitle: string;
  maxPosts?: number;
}

const { posts, title, subtitle, maxPosts } = Astro.props;
const visiblePosts = maxPosts ? posts.slice(0, maxPosts) : posts;
---

<SectionContainer
  id="blog"
  background="gradient-primary"
  padding="sm"
  waveBottom
  waveColorClass="text-white"
>
  <SectionHeader title={title} subtitle={subtitle} titleColor="secondary" subtitleColor="gray-600" />

  {
    posts.length === 0 ? (
      <EmptyState
        title={pagesData.states.empty.blog.title}
        description={pagesData.states.empty.blog.description}
      />
    ) : (
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 justify-center">
        {visiblePosts.map((post: BlogPost) => (
          <BlogCard post={post} />
        ))}
      </div>
    )
  }
</SectionContainer>
