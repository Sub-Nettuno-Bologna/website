---
import { pagesData } from "@/data/pages";
import StandardCard from "@/components/common/cards/StandardCard.astro";
---

<StandardCard
  variant="default"
  hoverEffect={false}
  customClass="mt-12 bg-white p-6 shadow-t-lg rounded-b-3xl"
>
  <div class="md:flex items-center justify-between">
    <div class="mb-4 md:mb-0">
      <h3 class="text-xl font-bold text-secondary">
        {pagesData.newsletter.title}
      </h3>
      <p class="text-gray-600">
        {pagesData.newsletter.description}
      </p>
    </div>
    <form class="flex" aria-label={pagesData.newsletter.title}>
      <label for="newsletter-email" class="sr-only">{pagesData.newsletter.form.placeholder}</label>
      <input
        id="newsletter-email"
        name="email"
        type="email"
        placeholder={pagesData.newsletter.form.placeholder}
        autocomplete="email"
        required
        class="px-4 py-2 rounded-l-full border border-gray-300 focus:outline-none focus:ring-2 focus:ring-primary w-full md:w-auto"
      />
      <button
        type="submit"
        class="bg-primary text-white px-6 py-2 rounded-r-full hover:bg-secondary transition duration-300 font-medium"
        >{pagesData.newsletter.form.buttonText}</button
      >
    </form>
  </div>
</StandardCard>
