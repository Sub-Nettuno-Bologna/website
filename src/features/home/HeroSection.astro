---
import { ArrowRight } from "@lucide/astro";
import type { Hero } from "sanity.types";
import Button from "@/components/primitives/Button.astro";
import SectionContainer from "@/components/layout/Section.astro";
import { buildImageUrl } from "@/lib/sanity";

export interface Props extends Hero {}

const { images, subtitle, buttons } = Astro.props;

// Use Sanity images for the hero carousel
const carouselImages =
  images?.map((image) =>
    buildImageUrl(image, { width: 1920, height: 1080 })
  ) ?? [];
---

<style>
  /* Slide-left carousel */
  .hero-carousel-image {
    transform: translateX(100%);
    transition: transform 900ms ease-in-out;
    will-change: transform;
  }

  .hero-carousel-image.is-active {
    transform: translateX(0);
    z-index: 1;
  }

  .hero-carousel-image.is-prev {
    transform: translateX(-100%);
    z-index: 0;
  }

  .hero-carousel-image.is-next {
    transform: translateX(100%);
    z-index: 0;
  }

  .hero-carousel-image.no-transition {
    transition: none !important;
  }

  .hero-title-gradient {
    background-image: linear-gradient(to right, var(--color-orange), var(--color-orange));
  }

  .hero-logo {
    filter: brightness(0) saturate(100%) invert(64%) sepia(95%) saturate(1352%) hue-rotate(1deg)
      brightness(102%) contrast(101%);
    max-width: 200px;
    width: auto;
    height: auto;
  }

  @media (min-width: 640px) {
    .hero-logo {
      max-width: 250px;
    }
  }

  @media (min-width: 768px) {
    .hero-logo {
      max-width: 300px;
    }
  }

  @media (min-width: 1024px) {
    .hero-logo {
      max-width: 600px;
    }
  }
</style>

<SectionContainer
  id="home"
  background="default"
  padding="sm"
  customClass="relative h-[65vh] flex items-center justify-center overflow-hidden !py-0"
  waveColorClass="color-gradient-secondary"
>
  <div class="absolute inset-0 w-full h-full bg-primary">
    <!-- <div class="absolute inset-0 bg-black/40 z-10"></div> -->

    {carouselImages.map((src, index) => (
      <img
        id={`hero-image-${index}`}
        class={`hero-carousel-image w-full h-full object-cover absolute inset-0 ${index === 0 ? "is-active" : "is-next"}`}
        src={src}
        width={1920}
        height={1080}
        sizes="100vw"
        fetchpriority={index === 0 ? "high" : "low"}
        loading={index === 0 ? "eager" : "lazy"}
        decoding="async"
        alt=""
        aria-hidden="true"
      />
    ))}
  </div>

  <div class="relative z-20 text-center text-white max-w-4xl mx-auto px-4">
    <div class="mb-4 md:mb-6 animate-fade-in drop-shadow-[0_2px_8px_rgba(0,0,0,0.8)]">
      <img
        src="/logo.svg"
        alt="Club Sub Nettuno"
        class="hero-logo mx-auto mb-4"
        width="200"
        style="height: auto;"
        loading="eager"
      />
    </div>
    <p
      class="text-lg sm:text-xl md:text-2xl mb-6 md:mb-8 text-white drop-shadow-[0_2px_4px_rgba(0,0,0,0.8)]"
    >
      E ora immergiti con noi..
      {subtitle}
    </p>
    <div class="flex flex-col sm:flex-row gap-3 sm:gap-4 justify-center">
      {
        buttons?.map((button) => (
          <Button href={button.href} size="lg" variant={button.variant || "default"}>
            <span class="flex items-center justify-center">
              {button.text}
              <ArrowRight class="ml-2 w-4 sm:w-5 h-4 sm:h-5" />
            </span>
          </Button>
        ))
      }
    </div>
  </div>
</SectionContainer>

<script>
  const images = Array.from(
    document.querySelectorAll<HTMLImageElement>("img[id^='hero-image-']")
  );
  let currentImageIndex = 0;
  const SLIDE_DURATION = 6000; // 6 seconds per image
  const TRANSITION_DURATION = 900; // keep in sync with CSS

  function showNextImage() {
    if (images.length === 0) return;

    const currentImage = images[currentImageIndex];
    const nextImageIndex = (currentImageIndex + 1) % images.length;
    const nextImage = images[nextImageIndex];

    // Ensure the next image starts from the right
    nextImage.classList.remove("is-prev", "no-transition");
    nextImage.classList.add("is-next");

    // Trigger the slide transition on the next frame
    requestAnimationFrame(() => {
      // Current image slides out left
      currentImage.classList.remove("is-active");
      currentImage.classList.add("is-prev");

      // Next image slides in from right to center
      nextImage.classList.remove("is-next");
      nextImage.classList.add("is-active");
    });

    // After the transition, reset the previous image to the right (ready for reuse)
    window.setTimeout(() => {
      currentImage.classList.add("no-transition");
      currentImage.classList.remove("is-prev", "is-active");
      currentImage.classList.add("is-next");
      // Force reflow so the no-transition takes effect before we re-enable transitions
      void currentImage.offsetHeight;
      currentImage.classList.remove("no-transition");
    }, TRANSITION_DURATION + 50);

    // Update current index
    currentImageIndex = nextImageIndex;
  }

  // Start the carousel
  function startCarousel() {
    if (images.length > 1) {
      setInterval(showNextImage, SLIDE_DURATION);
    }
  }

  // Initialize carousel when page loads
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", startCarousel);
  } else {
    startCarousel();
  }
</script>
