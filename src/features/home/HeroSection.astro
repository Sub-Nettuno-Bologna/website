---
import { ArrowRight } from "@lucide/astro";
import type { Hero } from "sanity.types";
import Button from "@/components/primitives/Button.astro";
import SectionContainer from "@/components/layout/Section.astro";
import { buildImageUrl } from "@/lib/sanity";

export interface Props extends Hero {}

const { images, subtitle, buttons, title } = Astro.props;

// Use Sanity images for the hero carousel
const carouselImages =
  images?.map((image) =>
    buildImageUrl(image, { width: 1920, height: 1080 })
  ) ?? [];
---

<style>
  /* Zoom IN: scale 1 → 1.05 */
  @keyframes heroZoomIn {
    from {
      transform: scale(1);
    }
    to {
      transform: scale(var(--hero-zoom-scale));
    }
  }

  /* Zoom OUT: scale 1.05 → 1 */
  @keyframes heroZoomOut {
    from {
      transform: scale(var(--hero-zoom-scale));
    }
    to {
      transform: scale(1);
    }
  }

  /* Fade carousel with alternating zoom */
  .hero-carousel-image {
    /* Keep in sync with SLIDE_DURATION and CROSSFADE_DURATION in the script below */
    --hero-slide-duration: 6000ms;
    --hero-crossfade-duration: 1500ms;
    --hero-zoom-scale: 1.05;

    opacity: 0;
    transform: scale(1);
    transition: opacity var(--hero-crossfade-duration) ease-in-out;
    transform-origin: center center;
    will-change: opacity, transform;
  }

  /* Active image with zoom IN */
  .hero-carousel-image.is-active.zoom-in {
    opacity: 1;
    z-index: 2;
    animation: heroZoomIn var(--hero-slide-duration) ease-out forwards;
  }

  /* Active image with zoom OUT */
  .hero-carousel-image.is-active.zoom-out {
    opacity: 1;
    z-index: 2;
    animation: heroZoomOut var(--hero-slide-duration) ease-out forwards;
  }

  /* Outgoing image: fading out, frozen at its end scale */
  .hero-carousel-image.is-fading-out {
    opacity: 0;
    z-index: 1;
  }

  /* Waiting images: hidden */
  .hero-carousel-image.is-waiting {
    opacity: 0;
    z-index: 0;
  }

  .hero-carousel-image.no-transition {
    transition: none !important;
    animation: none !important;
  }

  .hero-title-gradient {
    background-image: linear-gradient(to right, var(--color-orange), var(--color-orange));
  }

  .hero-logo {
    filter: brightness(0) saturate(100%) invert(64%) sepia(95%) saturate(1352%) hue-rotate(1deg)
      brightness(102%) contrast(101%);
    max-width: 200px;
    width: auto;
    height: auto;
  }

  @media (min-width: 640px) {
    .hero-logo {
      max-width: 250px;
    }
  }

  @media (min-width: 768px) {
    .hero-logo {
      max-width: 300px;
    }
  }

  @media (min-width: 1024px) {
    .hero-logo {
      max-width: 600px;
    }
  }
</style>

<SectionContainer
  id="home"
  background="default"
  padding="sm"
  customClass="relative min-h-[80vh] flex items-center justify-center overflow-hidden !py-0"
  waveColorClass="color-gradient-secondary"
>
  <div class="absolute inset-0 w-full h-full bg-gradient-to-b from-primary via-secondary to-primary">
    <!-- Ocean gradient overlay -->
    <div class="absolute inset-0 bg-gradient-to-b from-transparent via-primary/10 to-primary/20 z-10"></div>
    {carouselImages.map((src, index) => (
      <img
        id={`hero-image-${index}`}
        class={`hero-carousel-image w-full h-full object-cover absolute inset-0 ${index === 0 ? "is-active zoom-in" : "is-waiting"}`}
        src={src}
        width={1920}
        height={1080}
        sizes="100vw"
        fetchpriority={index === 0 ? "high" : "low"}
        loading={index === 0 ? "eager" : "lazy"}
        decoding="async"
        alt={`${title || "Home"} – immagine di sfondo ${index + 1}`}
        aria-hidden="true"
      />
    ))}

  </div>

  <div class="relative z-20 text-center text-white max-w-4xl mx-auto px-4">
    <div class="mb-4 md:mb-6 animate-fade-in drop-shadow-[0_2px_8px_rgba(0,0,0,0.8)]">
      <img
        src="/logo.svg"
        alt="Club Sub Nettuno"
        class="hero-logo mx-auto mb-4 animate-emerge"
        width="200"
        style="height: auto;"
        loading="eager"
      />
    </div>
    <h1 class="text-4xl font-bold mb-4">{title}</h1>
    <!-- Subtitle with fade-in delay -->
    <p
      class="text-lg sm:text-xl md:text-2xl mb-6 md:mb-8 text-white drop-shadow-[0_2px_8px_rgba(0,0,0,0.9)] fade-in-on-scroll"
      style="animation-delay: 0.2s;"
    >
      {subtitle}
    </p>
    <!-- CTA buttons with fade-in delay -->
    <div class="flex flex-col sm:flex-row gap-3 sm:gap-4 justify-center fade-in-on-scroll" style="animation-delay: 0.4s;">
      {
        buttons?.map((button) => (
          <Button href={button.href} size="lg" variant={button.variant || "default"}>
            <span class="flex items-center justify-center">
              {button.text}
              <ArrowRight class="ml-2 w-4 sm:w-5 h-4 sm:h-5" />
            </span>
          </Button>
        ))
      }
    </div>
  </div>
</SectionContainer>

<script>
  const images = Array.from(
    document.querySelectorAll<HTMLImageElement>("img[id^='hero-image-']")
  );
  let currentImageIndex = 0;
  let isZoomingIn = true; // First image zooms IN, next will zoom OUT, etc.
  
  // Keep in sync with CSS variables
  const SLIDE_DURATION = 6000; // --hero-slide-duration
  const CROSSFADE_DURATION = 1500; // --hero-crossfade-duration
  const ZOOM_SCALE = 1.05; // --hero-zoom-scale

  function showNextImage() {
    if (images.length === 0) return;

    const currentImage = images[currentImageIndex];
    const nextImageIndex = (currentImageIndex + 1) % images.length;
    const nextImage = images[nextImageIndex];
    
    // Determine end scale of current image and start scale for next
    // If current zoomed IN (1→1.05), it ends at 1.05, so next starts at 1.05 and zooms OUT
    // If current zoomed OUT (1.05→1), it ends at 1, so next starts at 1 and zooms IN
    const currentEndScale = isZoomingIn ? ZOOM_SCALE : 1;
    const nextZoomIn = !isZoomingIn; // Alternate

    // Prepare next image: set starting scale to match current image's end scale
    nextImage.classList.add("no-transition");
    nextImage.classList.remove("is-active", "is-fading-out", "zoom-in", "zoom-out");
    nextImage.classList.add("is-waiting");
    nextImage.style.transform = `scale(${currentEndScale})`;
    void nextImage.offsetHeight;
    nextImage.classList.remove("no-transition");

    // Start the crossfade
    requestAnimationFrame(() => {
      // Freeze current image at its end scale
      currentImage.style.transform = `scale(${currentEndScale})`;
      currentImage.classList.remove("is-active", "zoom-in", "zoom-out");
      currentImage.classList.add("is-fading-out");

      // Next image fades in and starts its zoom animation
      nextImage.classList.remove("is-waiting");
      nextImage.classList.add("is-active", nextZoomIn ? "zoom-in" : "zoom-out");
      nextImage.style.transform = ""; // Let the animation take over
    });

    // After crossfade completes, clean up the previous image
    window.setTimeout(() => {
      currentImage.classList.add("no-transition");
      currentImage.classList.remove("is-fading-out");
      currentImage.classList.add("is-waiting");
      currentImage.style.transform = "";
      void currentImage.offsetHeight;
      currentImage.classList.remove("no-transition");
    }, CROSSFADE_DURATION + 100);

    // Update state for next transition
    currentImageIndex = nextImageIndex;
    isZoomingIn = nextZoomIn;
  }

  // Start the carousel
  function startCarousel() {
    if (images.length > 1) {
      setInterval(showNextImage, SLIDE_DURATION);
    }
  }

  // Initialize carousel when page loads
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", startCarousel);
  } else {
    startCarousel();
  }

  // Trigger initial fade-in for hero elements
  window.addEventListener("load", () => {
    const heroElements = document.querySelectorAll(".fade-in-on-scroll");
    heroElements.forEach((el, index) => {
      setTimeout(() => {
        el.classList.add("visible");
      }, index * 200);
    });
  });
</script>
