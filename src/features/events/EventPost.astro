---
import type { Event } from "../../../sanity.types";
import { formatDate, formatPriceEUR, isPast } from "@/lib/utils";
import PostArticle from "@/features/posts/PostArticle.astro";
import { Calendar, MapPin, Users, Tag, Clock } from "@lucide/astro";
import { pagesData } from "@/data/pages";

const eventLabels = pagesData.eventi.labels;

export interface Props {
  post: Event;
  backUrl: string;
}

const { post, backUrl } = Astro.props;
const deadlineLabel = post.registrationDeadline ? formatDate(post.registrationDeadline) : undefined;
const isExpired = post.eventDate ? isPast(post.eventDate) : false;
---

<PostArticle
  title={post.title}
  excerpt={post.excerpt}
  content={post.content}
  featuredImage={post.featuredImage}
  featured={post.featured}
  backUrl={backUrl}
>
  <div slot="meta" class="mt-4">
    <div class="rounded-xl border border-gray-200 bg-white/70 backdrop-blur px-5 py-4">
      {
        isExpired && (
          <span class="mb-3 inline-flex items-center gap-2 rounded-full bg-red-50 px-3 py-1 text-xs font-semibold text-red-700">
            <svg class="h-3 w-3" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <circle cx="12" cy="12" r="10" />
            </svg>
            {eventLabels.concluded}
          </span>
        )
      }

      <dl class="grid grid-cols-1 gap-y-3 sm:grid-cols-2 sm:gap-x-6">
        {
          post.eventDate && (
            <div class="flex items-start gap-3 text-gray-700">
              <Calendar class="h-5 w-5 text-primary" aria-hidden="true" />
              <div>
                <dt class="text-xs uppercase tracking-wide text-gray-500">{eventLabels.date}</dt>
                <dd class="text-base font-medium">{formatDate(post.eventDate)}</dd>
              </div>
            </div>
          )
        }
        {
          post.location && (
            <div class="flex items-start gap-3 text-gray-700">
              <MapPin class="h-5 w-5 text-primary" aria-hidden="true" />
              <div>
                <dt class="text-xs uppercase tracking-wide text-gray-500">
                  {eventLabels.location}
                </dt>
                <dd class="text-base font-medium">{post.location}</dd>
              </div>
            </div>
          )
        }

        {
          post.price && (
            <div class="flex items-start gap-3 text-gray-700">
              <Tag class="h-5 w-5 text-primary" aria-hidden="true" />
              <div>
                <dt class="text-xs uppercase tracking-wide text-gray-500">{eventLabels.price}</dt>
                <dd class="text-base font-medium">{formatPriceEUR(post.price)}</dd>
              </div>
            </div>
          )
        }

        {
          post.maxParticipants && (
            <div class="flex items-start gap-3 text-gray-700">
              <Users class="h-5 w-5 text-primary" aria-hidden="true" />
              <div>
                <dt class="text-xs uppercase tracking-wide text-gray-500">
                  {pagesData.eventi.participantsLabel}
                </dt>
                <dd class="text-base font-medium">{post.maxParticipants}</dd>
              </div>
            </div>
          )
        }

        {
          post.registrationRequired && (
            <div class="flex items-start gap-3 text-gray-700">
              <Clock class="h-5 w-5 text-primary" aria-hidden="true" />
              <div>
                <dt class="text-xs uppercase tracking-wide text-gray-500">
                  {eventLabels.registration}
                </dt>
                <dd class="text-base font-medium">
                  {deadlineLabel
                    ? `${eventLabels.registrationBy} ${deadlineLabel}`
                    : eventLabels.registrationRequired}
                </dd>
              </div>
            </div>
          )
        }
      </dl>
    </div>
  </div>
</PostArticle>
