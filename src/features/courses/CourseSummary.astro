---
import type { Course } from "../../../sanity.types";
import { CalendarDays, Users, HeartHandshake } from "@lucide/astro";
import Card from "@/components/primitives/Card/Card.astro";
import CardHeader from "@/components/primitives/Card/CardHeader.astro";
import CardTitle from "@/components/primitives/Card/CardTitle.astro";
import CardContent from "@/components/primitives/Card/CardContent.astro";

export interface Props {
  course: Pick<Course, "coursePeriod" | "enrollmentNote" | "contributionNote">;
}

const { course } = Astro.props;
const items = [
  { label: "Periodo", value: course.coursePeriod?.trim(), icon: CalendarDays },
  { label: "Frequenza", value: course.enrollmentNote?.trim(), icon: Users },
  { label: "Contributo", value: course.contributionNote?.trim(), icon: HeartHandshake },
].filter((item) => item.value);
---

{
  items.length > 0 && (
    <section
      aria-label="Informazioni sul corso"
      class="grid md:grid-cols-3 gap-8 my-8"
    >
      {items.map(({ label, value, icon: Icon }) => (
        <Card class="w-full course-summary-card">
          <CardHeader class="text-center">
            <CardTitle>{label}</CardTitle>
          </CardHeader>
          <CardContent>
            <div class="flex flex-col items-center text-center">
              <Icon class="w-12 h-12 mb-4 text-primary flex-shrink-0" aria-hidden="true" />
              <p class="leading-relaxed whitespace-pre-line">
                {label === "Periodo"
                  ? value?.split(/(gennaio|febbraio|marzo|aprile|maggio|giugno|luglio|agosto|settembre|ottobre|novembre|dicembre)/gi)
                      .map((part, index) => index % 2 === 1 ? <strong>{part}</strong> : part)
                  : value}
              </p>
            </div>
          </CardContent>
        </Card>
      ))}
    </section>
  )
}

<style>
  .course-summary-card {
    background-color: white;
  }
</style>
