---
import Layout from "@/layouts/Layout.astro";
import BlogSection from "@/features/blog/BlogSection.astro";
import Pagination from "@/components/common/Pagination.astro";
import { getBlogPosts, getBlogTotalCount } from "@/services/blog";
import { DEFAULT_PAGE_SIZE, buildStaticPaths, clampPage, getTotalPages } from "@/lib/pagination";
import { pagesData } from "@/data/pages";

export async function getStaticPaths() {
  const totalCount = await getBlogTotalCount();
  return buildStaticPaths(totalCount, DEFAULT_PAGE_SIZE);
}

const { page } = Astro.params;
const currentPage = clampPage(page);
const posts = await getBlogPosts({ page: currentPage, pageSize: DEFAULT_PAGE_SIZE });
const totalCount = await getBlogTotalCount();
const totalPages = getTotalPages(totalCount, DEFAULT_PAGE_SIZE);
---

<Layout>
  <BlogSection
    posts={posts}
    title={pagesData.blog.title}
    subtitle={pagesData.blog.subtitle}
    showFeatured={true}
  />
  <Pagination
    currentPage={currentPage}
    totalPages={totalPages}
    indexPath="/blog"
    pageBasePath="/blog/page"
  />
</Layout>
