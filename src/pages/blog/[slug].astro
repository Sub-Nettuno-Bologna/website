---
import Layout from "@/layouts/Layout.astro";
import BlogPost from "@/features/blog/BlogPost.astro";
import BlogPostingSeoSchema from "@/seo/BlogPostingSeoSchema.astro";
import { getBlogPostBySlug, getBlogPosts } from "@/services/blog";
import type { InferGetStaticParamsType } from "astro";

export async function getStaticPaths() {
  const posts = await getBlogPosts();
  return posts.map((post) => ({
    params: { slug: post.slug.current },
  }));
}

type Params = InferGetStaticParamsType<typeof getStaticPaths>;
const { slug } = Astro.params as Params;

const post = await getBlogPostBySlug(slug || "");

if (!post) {
  Astro.redirect("/blog/");
}
---

<Layout title={post?.title}>
  {post && <BlogPostingSeoSchema post={post} />}
  <BlogPost post={post} backUrl="/blog/" />
</Layout>
