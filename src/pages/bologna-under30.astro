---
import Layout from "@/layouts/Layout.astro";
import SectionContainer from "@/components/layout/Section.astro";
import SectionHeader from "@/components/layout/SectionHeader.astro";
import Button from "@/components/primitives/Button.astro";
import Card from "@/components/primitives/Card/Card.astro";
import CardContent from "@/components/primitives/Card/CardContent.astro";
import CardHeader from "@/components/primitives/Card/CardHeader.astro";
import CardTitle from "@/components/primitives/Card/CardTitle.astro";
import ContactSection from "@/features/contact/ContactSection.astro";
import { Waves, Users, Award, Star, CheckCircle, HelpCircle } from "@lucide/astro";
---

<Layout>
  <!-- Hero Section -->
  <SectionContainer
    id="hero"
    background="default"
    padding="xl"
    customClass="relative overflow-hidden bg-gradient-to-b from-primary to-secondary"
  >
    <div class="absolute inset-0 opacity-10">
      <Waves class="w-full h-full text-white" />
    </div>
    <div class="relative z-10 text-center text-white max-w-4xl mx-auto">
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold mb-6 drop-shadow-lg">
        Ciao Bologna! 🌊
      </h1>
      <p class="text-xl md:text-2xl mb-4 font-medium drop-shadow-md">
        Siete pronti a spezzare la routine e scoprire un mondo sommerso?
      </p>
      <p class="text-lg md:text-xl mb-8 text-white/90 drop-shadow-sm">
        Che tu sia uno studente che cerca adrenalina post-esame o un under 30 in cerca di una nuova,
        incredibile passione, abbiamo il corso che fa per te!
      </p>
      <Button
        href="#contatti"
        size="lg"
        variant="white"
        class="text-lg px-8 py-4 shadow-xl hover:shadow-2xl transition-all"
      >
        Chiedi informazioni ora →
      </Button>
    </div>
  </SectionContainer>

  <!-- Offer Section -->
  <SectionContainer id="offerta" background="white" padding="lg">
    <div class="max-w-4xl mx-auto">
      <div class="bg-gradient-to-r from-primary to-secondary text-white rounded-2xl p-8 md:p-12 shadow-2xl">
        <div class="flex items-center justify-center mb-6">
          <Star class="w-12 h-12 mr-3" />
          <h2 class="text-3xl md:text-4xl font-bold">L'OFFERTA PER VOI GIOVANI DI BOLOGNA</h2>
        </div>
        <p class="text-xl md:text-2xl mb-6 text-center font-medium">
          Se sei <strong>Under 30</strong> o uno <strong>Studente Universitario</strong> (anche fuori
          sede), hai diritto a uno <strong>sconto speciale del 15%</strong> sul costo del tuo primo
          corso!
        </p>
        <div class="bg-white/10 backdrop-blur-sm rounded-xl p-6 mt-6">
          <h3 class="text-xl font-semibold mb-4 flex items-center">
            <CheckCircle class="w-6 h-6 mr-2" />
            Come ottenerlo:
          </h3>
          <ul class="space-y-3 text-lg">
            <li class="flex items-start">
              <span class="mr-3 font-bold">1.</span>
              <span>Compila il form qui sotto con le tue informazioni</span>
            </li>
            <li class="flex items-start">
              <span class="mr-3 font-bold">2.</span>
              <span>Menziona che sei Under 30 o Studente UniBo nel messaggio</span>
            </li>
            <li class="flex items-start">
              <span class="mr-3 font-bold">3.</span>
              <span>Mostraci un documento/tessera universitaria all'inizio del corso</span>
            </li>
          </ul>
        </div>
        <p class="text-center mt-6 text-lg font-semibold">
          Posti Limitati! Non aspettare che l'estate sia finita. Inizia ora ad allenarti per la tua
          prossima vacanza!
        </p>
      </div>
    </div>
  </SectionContainer>

  <!-- Courses Section -->
  <SectionContainer id="corsi" background="gray" padding="lg">
    <SectionHeader
      title="I Nostri Corsi"
      subtitle="Scegli il percorso che fa per te e inizia la tua avventura subacquea"
      titleColor="secondary"
      subtitleColor="gray-600"
      titleSize="xl"
      hasBreadcrumbs={false}
    />

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-5xl mx-auto mt-12">
      <!-- Apnea Course Card -->
      <Card class="h-full hover:shadow-xl transition-shadow duration-300 border-2 border-blue-200">
        <CardHeader>
          <div class="flex items-center mb-4">
            <div class="w-12 h-12 bg-blue-500 rounded-full flex items-center justify-center mr-4">
              <Waves class="w-6 h-6 text-white" />
            </div>
            <CardTitle class="text-2xl text-blue-700">Corso di Apnea</CardTitle>
          </div>
          <p class="text-lg font-semibold text-blue-600 mb-2">Liberi e in Armonia</p>
        </CardHeader>
        <CardContent>
          <p class="text-gray-700 mb-4 leading-relaxed">
            Vuoi imparare a gestire il respiro, superare i tuoi limiti e sentirti completamente in
            pace sott'acqua? L'apnea è meditazione e sport insieme.
          </p>
          <ul class="space-y-2 mb-6">
            <li class="flex items-start">
              <CheckCircle class="w-5 h-5 text-blue-500 mr-2 mt-0.5 flex-shrink-0" />
              <span class="text-gray-700">Ti insegneremo a rimanere sott'acqua in sicurezza</span>
            </li>
            <li class="flex items-start">
              <CheckCircle class="w-5 h-5 text-blue-500 mr-2 mt-0.5 flex-shrink-0" />
              <span class="text-gray-700">Solo con la forza dei tuoi polmoni e della tua mente</span>
            </li>
            <li class="flex items-start">
              <CheckCircle class="w-5 h-5 text-blue-500 mr-2 mt-0.5 flex-shrink-0" />
              <span class="text-gray-700">Un'esperienza di crescita personale e benessere</span>
            </li>
          </ul>
          <Button href="#contatti" variant="default" class="w-full">
            Chiedi informazioni →
          </Button>
        </CardContent>
      </Card>

      <!-- Open Water Course Card -->
      <Card class="h-full hover:shadow-xl transition-shadow duration-300 border-2 border-red-200">
        <CardHeader>
          <div class="flex items-center mb-4">
            <div class="w-12 h-12 bg-red-500 rounded-full flex items-center justify-center mr-4">
              <Users class="w-6 h-6 text-white" />
            </div>
            <CardTitle class="text-2xl text-red-700">Corso Subacqueo</CardTitle>
          </div>
          <p class="text-lg font-semibold text-red-600 mb-2">Open Water - Esplora con le Bombole</p>
        </CardHeader>
        <CardContent>
          <p class="text-gray-700 mb-4 leading-relaxed">
            Sogni di nuotare con i pesci colorati e di esplorare relitti? Il brevetto Open Water è
            il tuo passaporto per il mondo subacqueo.
          </p>
          <ul class="space-y-2 mb-6">
            <li class="flex items-start">
              <CheckCircle class="w-5 h-5 text-red-500 mr-2 mt-0.5 flex-shrink-0" />
              <span class="text-gray-700">Impara a usare l'attrezzatura in totale sicurezza</span>
            </li>
            <li class="flex items-start">
              <CheckCircle class="w-5 h-5 text-red-500 mr-2 mt-0.5 flex-shrink-0" />
              <span class="text-gray-700">Brevetto riconosciuto internazionalmente (CMAS/FIPSAS)</span>
            </li>
            <li class="flex items-start">
              <CheckCircle class="w-5 h-5 text-red-500 mr-2 mt-0.5 flex-shrink-0" />
              <span class="text-gray-700">Preparati per le tue avventure in mare!</span>
            </li>
          </ul>
          <Button href="#contatti" variant="default" class="w-full">
            Chiedi informazioni →
          </Button>
        </CardContent>
      </Card>
    </div>
  </SectionContainer>

  <!-- FAQ Section -->
  <SectionContainer id="faq" background="white" padding="lg">
    <SectionHeader
      title="Domande Frequenti"
      subtitle="Tutto quello che vuoi sapere prima di iniziare"
      titleColor="secondary"
      subtitleColor="gray-600"
      titleSize="lg"
      hasBreadcrumbs={false}
    />

    <div class="max-w-3xl mx-auto mt-12 space-y-6">
      <Card class="border-l-4 border-l-primary">
        <CardContent class="pt-6">
          <div class="flex items-start">
            <HelpCircle class="w-6 h-6 text-primary mr-3 mt-1 flex-shrink-0" />
            <div>
              <h3 class="text-xl font-semibold mb-2 text-gray-900">Serve esperienza?</h3>
              <p class="text-gray-700">
                Assolutamente no! I nostri corsi partono da zero. Ti accompagneremo passo dopo passo
                in totale sicurezza, anche se non hai mai messo la testa sott'acqua.
              </p>
            </div>
          </div>
        </CardContent>
      </Card>

      <Card class="border-l-4 border-l-primary">
        <CardContent class="pt-6">
          <div class="flex items-start">
            <HelpCircle class="w-6 h-6 text-primary mr-3 mt-1 flex-shrink-0" />
            <div>
              <h3 class="text-xl font-semibold mb-2 text-gray-900">Dove si svolge il corso?</h3>
              <p class="text-gray-700">
                Le lezioni teoriche e pratiche si svolgono nella nostra piscina a Bologna. Per le
                immersioni finali, organizziamo uscite in mare in località vicine.
              </p>
            </div>
          </div>
        </CardContent>
      </Card>

      <Card class="border-l-4 border-l-primary">
        <CardContent class="pt-6">
          <div class="flex items-start">
            <HelpCircle class="w-6 h-6 text-primary mr-3 mt-1 flex-shrink-0" />
            <div>
              <h3 class="text-xl font-semibold mb-2 text-gray-900">Quanto dura il corso?</h3>
              <p class="text-gray-700">
                Il corso Open Water dura generalmente 4-6 settimane con lezioni settimanali. Il corso
                di Apnea può essere più flessibile e personalizzato in base alle tue esigenze.
              </p>
            </div>
          </div>
        </CardContent>
      </Card>

      <Card class="border-l-4 border-l-primary">
        <CardContent class="pt-6">
          <div class="flex items-start">
            <HelpCircle class="w-6 h-6 text-primary mr-3 mt-1 flex-shrink-0" />
            <div>
              <h3 class="text-xl font-semibold mb-2 text-gray-900">È sicuro?</h3>
              <p class="text-gray-700">
                Sì! La sicurezza è la nostra priorità. Tutti i nostri istruttori sono certificati
                CMAS/FIPSAS e seguiamo rigorosamente gli standard internazionali. Inoltre, offriamo
                una <strong>prima prova gratuita</strong> per farti sentire a tuo agio.
              </p>
            </div>
          </div>
        </CardContent>
      </Card>

      <Card class="border-l-4 border-l-primary">
        <CardContent class="pt-6">
          <div class="flex items-start">
            <HelpCircle class="w-6 h-6 text-primary mr-3 mt-1 flex-shrink-0" />
            <div>
              <h3 class="text-xl font-semibold mb-2 text-gray-900">Cosa serve per iniziare?</h3>
              <p class="text-gray-700">
                Solo la voglia di provare! L'attrezzatura necessaria viene fornita durante il corso.
                Per la prima prova gratuita, ti basta portare costume e asciugamano. Per lo sconto
                Under 30/Studente, ricordati di portare un documento o la tessera universitaria.
              </p>
            </div>
          </div>
        </CardContent>
      </Card>
    </div>
  </SectionContainer>

  <!-- Contact Section -->
  <ContactSection
    hasBreadcrumbs={false}
    formHiddenFields={{ campaign: "Sconto Instagram" }}
    formDefaultMessage="Ciao! Vi contatto da Instagram: sono interessato/a a saperne di più sui corsi e allo sconto Under 30/Studente. Vorrei informazioni su..."
  />
</Layout>

<style>
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  #hero {
    animation: fadeInUp 0.6s ease-out;
  }
</style>
