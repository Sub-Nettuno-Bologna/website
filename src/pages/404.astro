---
import Layout from "@/layouts/Layout.astro";
import Button from "@/components/primitives/Button.astro";

Astro.response.status = 404;

const title = "Pagina non trovata (404) | Sub Nettuno";
const description = "La pagina che stai cercando non esiste o è stata spostata.";
---

<Layout title={title} description={description} noWaves={true}>
  <section class="mx-auto max-w-5xl px-6 py-20">
    <div class="rounded-2xl bg-gray-50 p-8 md:p-12">
      <p class="text-sm font-semibold text-secondary">Errore 404</p>
      <h1 class="mt-3 text-3xl md:text-4xl font-bold text-tertiary">Pagina non trovata</h1>
      <p class="mt-4 text-lg text-gray-700 max-w-prose">
        La pagina che stai cercando non esiste o è stata spostata.
      </p>

      <div class="mt-8 flex flex-col sm:flex-row gap-3">
        <Button href="/" variant="default">Torna alla Home</Button>
        <Button href="/contatti" variant="outline">Contattaci</Button>
      </div>
    </div>
  </section>
</Layout>


