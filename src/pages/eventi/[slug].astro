---
import Layout from "@/layouts/Layout.astro";
import EventPost from "@/features/events/EventPost.astro";
import ContactSection from "@/features/contact/ContactSection.astro";
import { getEventBySlug, getEvents } from "@/services/events";
import { formatDate } from "@/lib/formatters";
import type { InferGetStaticParamsType } from "astro";

export async function getStaticPaths() {
  const posts = await getEvents();
  return posts.map((event) => ({
    params: { slug: event.slug?.current },
  }));
}

type Params = InferGetStaticParamsType<typeof getStaticPaths>;
const { slug } = Astro.params as Params;

const event = await getEventBySlug(slug || "");

if (!event) {
  Astro.redirect("/eventi");
}

const campaign = event?.title ? `Evento: ${event.title}` : "Evento";
const eventDateLabel = event?.eventDate ? formatDate(event.eventDate) : "";
const defaultMessage = event?.title
  ? `Ciao! Vorrei informazioni sull'evento "${event.title}"${eventDateLabel ? ` del ${eventDateLabel}` : ""}${event?.location ? ` (${event.location})` : ""}.`
  : undefined;
---

<Layout title={event?.title}>
  {event ? <EventPost post={event} backUrl="/eventi" /> : null}

  {event ? (
    <>
      <!-- Contact Section -->
      <ContactSection
        hasBreadcrumbs={false}
        formHiddenFields={{ campaign }}
        formDefaultMessage={defaultMessage}
      />
    </>
  ) : null}
</Layout>
