---
import Layout from "@/layouts/Layout.astro";
import Courses from "@/features/courses/CoursesSection.astro";
import { getCategoryBySlug, getAllCourseCategorySlugs } from "@/services/courses";

export async function getStaticPaths() {
    try {
        const categories = await getAllCourseCategorySlugs();
        return categories.map((category) => ({ params: { category } }));
    } catch (error) {
        console.error("Error generating static paths for course categories:", error);
        return [];
    }
}

const { params } = Astro;
const category = params.category as string;
const categoryDoc = await getCategoryBySlug(category);
---

<Layout title={categoryDoc?.title!}>
    <Courses
        courses={categoryDoc?.courses ?? []}
        category={category}
        title={categoryDoc?.title!}
        description={categoryDoc?.description!}
    />
</Layout>
