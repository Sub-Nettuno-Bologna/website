---
import Layout from "@/layouts/Layout.astro";
import AboutSection from "@/features/about/AboutSection.astro";
import CardSection from "@/components/layout/CardSection.astro";
import SectionContainer from "@/components/layout/Section.astro";
import SafeguardingPromoCard from "@/components/common/SafeguardingPromoCard.astro";
import { getAboutUs } from "@/services/aboutus";
import { getClubData } from "@/services/club";
const about = await getAboutUs();

const clubData = await getClubData();
---

<Layout title={`Chi Siamo - ${clubData?.clubName || "Club Sub Nettuno Bologna"}`}>
  <AboutSection {...about} />

  {
    about?.cardSections?.map((section, index) => (
      <CardSection
        background={index % 2 === 0 ? "white" : "gradient-secondary"}
        title={section.title ?? ""}
        description={section.description ?? ""}
        icon={section.icon as any}
        cta={
          section.cta
            ? {
                href: section.cta.href!,
                text: section.cta.text!,
              }
            : null
        }
        padding="lg"
      />
    ))
  }

  <SectionContainer background="white" padding="lg">
    <SafeguardingPromoCard class="max-w-3xl mx-auto" />
  </SectionContainer>

