{
  "name": "subnettuno",
  "main": "dist/_worker.js/index.js",
  "compatibility_date": "2025-12-14",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
    },
  },
  "workers_dev": true,
  "preview_urls": false,
}
